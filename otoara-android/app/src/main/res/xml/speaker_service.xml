<?xml version="1.0" encoding="utf-8"?>
<!--
  Hizmet YALNIZCA telefon/arama ekranlarindan olay alir. Sinirsiz bir
  erisilebilirlik hizmeti hem gereksiz genis bir yetki olur hem de Google Play
  Protect tarafindan (haklı olarak) supheli sayilip kurulum engellenir.

  Liste genis tutuldu cunku ureticiler arama ekranini farkli paketlerde
  tutuyor; Samsung'da com.samsung.android.incallui, saf Android'de
  com.android.incallui / com.google.android.dialer gibi.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="200"
    android:description="@string/speaker_service_desc"
    android:summary="@string/speaker_service_summary"
    android:packageNames="com.samsung.android.incallui,com.samsung.android.dialer,com.samsung.android.app.telephonyui,com.sec.android.app.dialertab,com.android.incallui,com.android.dialer,com.google.android.dialer,com.android.server.telecom" />
