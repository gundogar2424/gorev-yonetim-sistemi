<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Ekran kapaliyken de okumaya devam etmek icin -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Okuma bildirimi (oynat/duraklat dugmeleri) icin -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Cihazdaki metin okuma (TTS) motorunu gorebilmek icin.
         Android 11+ paket gorunurlugu kurallari geregi zorunlu. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".SesliPdfApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SesliPdf">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.SesliPdf">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Baska bir uygulamada PDF'e dokununca "Sesli PDF ile ac" ciksin -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="application/pdf" />
                <data android:scheme="file" android:mimeType="application/pdf" />
            </intent-filter>

            <!-- PDF paylasilinca da uygulama listede ciksin -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <!-- Sesli okumayi yuruten on plan servisi -->
        <service
            android:name=".tts.ReaderService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Bildirimdeki oynat / duraklat / ileri / geri / kapat dugmeleri -->
        <receiver
            android:name=".tts.ReaderActionReceiver"
            android:exported="false" />
    </application>
</manifest>
