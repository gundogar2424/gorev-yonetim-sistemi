# --- Vega MS SQL (SADECE db_datareader yetkili kullanıcı!) ---
VEGA_SQL_SERVER=192.168.1.10
# Adlandırılmış instance kullanıyorsanız (örn. SERVER\VEGA) PORT yerine bunu doldurun:
VEGA_SQL_INSTANCE=
VEGA_SQL_PORT=1433
VEGA_SQL_DATABASE=VEGADB
VEGA_SQL_USER=stok_okuyucu
VEGA_SQL_PASSWORD=degistir

# Vega tablo öneki: F{FIRMA}TBL...  ve  F{FIRMA}D{DONEM}TBL...
VEGA_FIRMA=0101
VEGA_DONEM=0001

# --- Uygulama ---
PORT=4000
YEREL_DB=./veri/stok.sqlite
# Hızlı tur: sadece yeni hareket gören stokların bakiyesi (saniye)
ESITLEME_HIZLI_SN=30
# Tam tur: tüm ürün kartları + tüm bakiyeler (dakika)
ESITLEME_TAM_DK=15
GORSEL_KLASOR=./veri/gorseller
